@model Leave.ViewModels.LeaveViewModel

@{
    ViewData["Title"] = "Request Leave";
}

<h2>Request Leave</h2>

<form asp-action="CreateLeave" method="post">

    <input type="hidden" asp-for="UserId" value="@ViewBag.UserID" />
    <input type="hidden" asp-for="Username" value="@ViewBag.Username" />

    <div class="mb-3">
        <label asp-for="Reason" class="form-label">Reason</label>
        <input asp-for="Reason" class="form-control" />
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FromDate" class="form-label">From Date</label>
        <input asp-for="FromDate" type="datetime-local" class="form-control" />
        <span asp-validation-for="FromDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ToDate" class="form-label">To Date</label>
        <input asp-for="ToDate" type="datetime-local" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Email"  class="form-label">Enter Admin Email</label>
        <input asp-for="Email"  class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <br />
    <div>
        <button type="submit" class="btn btn-primary">Submit Request</button>
        <a href="@Url.Action("Dashboard")" class="btn btn-info">Cancel</a>
    </div>
    
</form>
